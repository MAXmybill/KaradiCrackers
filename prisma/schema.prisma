// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cracker {
  id          String      @id @default(uuid())
  name        String
  price       Float
  quantity    Int
  isAvailable Boolean     @default(true)
  category    String?
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  customerName  String
  customerPhone String
  total         Float
  status        String      @default("PENDING") // PENDING, COLLECTED, CANCELLED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  crackerId String?
  cracker   Cracker? @relation(fields: [crackerId], references: [id], onDelete: SetNull)
  name      String
  price     Float
  quantity  Int
}
